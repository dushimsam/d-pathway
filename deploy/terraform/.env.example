# Copy to `.env` (git-ignored) and fill in. The Makefile loads this before
# running Terraform, so the key stays out of version control and off the CLI.
#
#   cp .env.example .env
#   # edit .env, then:
#   make apply

# Strettch Cloud API key — from https://cloud.strettch.com/p/settings/api-keys
STRETTCH_CLOUD_API_KEY=
