resource "strettchcloud_compute" "dpathway" {
  host_name      = var.host_name
  image          = var.image
  region         = var.region
  specification  = var.specification
  public_keys    = [trimspace(file(var.ssh_public_key_path))]
  with_public_ip = true
  tags           = var.tags
}

# Hand the VM's public IP straight to Ansible: Terraform writes the inventory so
# `terraform apply` → `ansible-playbook` needs no manual copy-paste of the IP.
resource "local_file" "ansible_inventory" {
  filename = "${path.module}/../ansible/inventory.ini"
  content  = <<-EOT
    # Generated by Terraform — do not edit by hand. Re-run `terraform apply`.
    [dpathway]
    ${strettchcloud_compute.dpathway.ipv4} ansible_user=root ansible_port=222 ansible_ssh_private_key_file=${var.ssh_private_key_path} ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null'
  EOT
}
