# Copy to secrets.yml (git-ignored) and fill in real values:
#   cp secrets.yml.example secrets.yml
# The playbook loads it automatically (vars_files).

# ── Auth ──────────────────────────────────────────────────────────────────
# MUST be a long random string (min 16 chars). Generate one, e.g.:
#   openssl rand -base64 48
jwt_secret: "CHANGE-ME-to-a-long-random-string-at-least-16-chars"
jwt_expires_in: "24h"

# ── Database (Postgres in Docker on the VM) ────────────────────────────────
postgres_user: dpathway
postgres_password: "CHANGE-ME-strong-db-password"
postgres_db: dpathway

# ── Cloudinary (signed direct uploads) ─────────────────────────────────────
# Required for the app to boot (the config schema validates these). Uploads
# only actually work with real values; placeholders let everything else run.
cloudinary_cloud_name: "placeholder-cloud"
cloudinary_api_key: "placeholder-key"
cloudinary_api_secret: "placeholder-secret"
cloudinary_upload_folder: "capstone"

# ── Stripe (wallet top-ups) — leave empty to disable top-ups gracefully ────
stripe_secret_key: ""
stripe_currency: "rwf"

# ── Resend (transactional email) — leave empty to log instead of send ──────
resend_api_key: ""
mail_from: "onboarding@resend.dev"
