# ───────────────────────── secrets — never commit ─────────────────────────
# Strettch Cloud API key + any app secrets loaded via env files.
.env
.env.*
!.env.example
*.auto.tfvars
secrets.yml
vault-password*

# SSH keypair used to reach the VM (private key especially).
ssh/*
!ssh/.gitkeep

# ───────────────────────── Terraform ─────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
tfplan
*.tfplan

# ───────────────────────── Ansible ─────────────────────────
# Inventory is generated by Terraform from the VM's IP.
ansible/inventory.ini
*.retry
