{
  "name": "d-pathway-api",
  "version": "0.1.0",
  "description": "D-Pathway backend — company-posted project platform for the Kigali graduate labour market",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typeorm": "node --loader ts-node/esm ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "node --loader ts-node/esm src/database/seeds/run.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cloudinary": "2.7.0",
    "dotenv": "17.2.4",
    "joi": "18.0.1",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "typeorm-naming-strategies": "4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.2.0",
    "@types/bcrypt": "5.0.2",
    "@types/node": "24.10.1",
    "@types/passport-jwt": "4.0.1",
    "oxlint": "1.46.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@swc/core@1.16.18": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
