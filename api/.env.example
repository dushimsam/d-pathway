# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- CORS: the Next.js web client origin ---
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres 16 in Docker, localhost only) ---
POSTGRES_USER=dpathway
POSTGRES_PASSWORD=dpathway
POSTGRES_DB=dpathway
DATABASE_URL=postgres://dpathway:dpathway@127.0.0.1:5432/dpathway

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# --- Cloudinary (signed direct uploads; API never stores file bytes) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
